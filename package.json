{
  "name": "freesound-grinnell-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/build-seo.js",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.js",
    "zip": "zip -r build.zip . -x \"node_modules/*\" -x \"dist/*\" -x \".git/*\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^4.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0"
  }
}
